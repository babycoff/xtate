{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babycoff/xtate/schemas/module.schema.json",
  "title": "Xtate module metadata",
  "type": "object",
  "required": [
    "name",
    "kind"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "scan",
        "probe",
        "output",
        "generate"
      ]
    },
    "short_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "probe_type": {
      "enum": [
        "udp",
        "tcp",
        "state",
        "none"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "enum": [
              "flag",
              "arg"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
