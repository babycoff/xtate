{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babycoff/xtate/schemas/scan-request.schema.json",
  "title": "Xtate scan request",
  "type": "object",
  "required": ["scan"],
  "properties": {
    "scan": {"type": "string", "minLength": 1},
    "probe": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "include_file": {
      "type": "string",
      "minLength": 1,
      "description": "Read targets from this file (one address or range per line). Mutually exclusive with targets."
    },
    "ports": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 65535}
    },
    "probe_args": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "scan_args": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "rate": {"type": "integer", "minimum": 0, "maximum": 10000, "description": "Total packets per second. When omitted, the worker uses the default of 100."},
    "timeout_sec": {"type": "integer", "minimum": 1, "maximum": 86400},
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "When true, only list the planned targets and send no packets. Omitted means a real scan."
    },
    "result_path": {"type": "string", "minLength": 1},
    "chunk_size": {"type": "integer", "minimum": 1},
    "compression": {"type": "string", "enum": ["none", "zstd"]},
    "index": {"type": "boolean"},
    "quota_bytes": {"type": "integer", "minimum": 0},
    "authorized": {
      "type": "boolean",
      "description": "Required by MCP start_scan before a job may be started."
    },
    "interface": {"type": "string", "minLength": 1}
  },
  "oneOf": [
    {"required": ["targets"], "not": {"required": ["include_file"]}},
    {"required": ["include_file"], "not": {"required": ["targets"]}}
  ],
  "additionalProperties": false
}
